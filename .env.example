# ================================
# BASE DE DATOS
# ================================
POSTGRES_USER=example
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ================================
# BACKEND / FASTAPI
# ================================
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ================================
# MINIO (Object Storage)
# ================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_long_random_password
MINIO_BUCKET=crediconfiemos-docs

# ================================
# SUPERSET (BI)
# ================================
SUPERSET_IMAGE=apache/superset:4.1.1
SUPERSET_VERSION=4.1.1
SUPERSET_SECRET_KEY=replace_with_at_least_32_random_characters
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=replace_with_a_long_random_password
SUPERSET_DB_NAME=superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace_with_a_long_random_password
SUPERSET_ADMIN_FIRSTNAME=Credi
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@crediconfiemos.local

# ================================
# FRONTEND
# ================================
NEXT_PUBLIC_API_URL=http://localhost:8000
